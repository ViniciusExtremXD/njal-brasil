---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { BRAND } from '../data/site';

const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<Base title="Página não encontrada — NJAL BRASIL" path="/404" noindex>
  <Nav />
  <main id="conteudo" class="nf">
    <div class="wrap nf__in">
      <p class="eyebrow"><b>404</b> — Página não encontrada</p>
      <h1 class="nf__title d">Essa rota<br /><span class="d--red">não chegou em Valhalla.</span></h1>
      <p class="copy">O endereço não existe ou mudou de lugar. Os drops continuam no Instagram e a venda, no WhatsApp.</p>
      <div class="cta-row">
        <a class="btn btn--red" href={home}>Voltar ao início</a>
        <a class="btn" href={BRAND.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" class="btn__icon" /> Instagram
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    min-height: 80svh;
    display: grid;
    align-items: center;
    padding-top: var(--nav-h);
  }

  .nf__in {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .nf__title {
    font-size: clamp(2.4rem, 1.4rem + 6vw, 7rem);
  }
</style>
