---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import ProductCard from '../components/ProductCard.astro';
import MapaBand from '../components/MapaBand.astro';
import Icon from '../components/Icon.astro';
import Monogram from '../components/Monogram.astro';
import { BRAND } from '../data/site';
import { CATEGORIES, LINES } from '../data/shop';

const shopCats = CATEGORIES.filter((c) => c.id !== 'todos');
---

<Base
  title="Loja — NJAL BRASIL"
  description="Catálogo oficial da NJAL: camisetas, moletons, regatas, shorts e acessórios. Escolha a peça e chame no WhatsApp pra fechar."
  path="/loja"
>
  <Nav />
  <main id="conteudo">
    <section class="loja-hero section--tight">
      <div class="loja-hero__glow" aria-hidden="true"></div>
      <div class="loja-hero__mono" aria-hidden="true" data-parallax="0.1">
        <Monogram outline strokeWidth={1} decorative />
      </div>
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>Loja oficial</b> · njal.com.br</p>
        <h1 class="loja-hero__title d" data-reveal="forge" data-split="forge">
          Veja o seu<br />
          <span class="d--red">próximo equipamento.</span>
        </h1>
        <p class="lead" data-reveal="fade" data-split="words" style="--i:2">
          Escolha a peça e chame no WhatsApp pra fechar — sem carrinho, sem checkout por aqui.
          Tamanho, cor e forma de pagamento se acertam direto na conversa.
        </p>
        <div class="cta-row" data-reveal style="--i:2">
          <a class="btn btn--red" href={BRAND.shopUrl} target="_blank" rel="noopener">
            Abrir njal.com.br
            <Icon name="arrow" class="btn__icon" />
          </a>
          <a class="btn" href={BRAND.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" class="btn__icon" />
            Tirar dúvida no WhatsApp
          </a>
        </div>
      </div>
    </section>

    <section class="loja section section--tight section--line" aria-label="Catálogo de produtos">
      <div class="wrap">
        <nav class="loja__jump" aria-label="Ir para categoria">
          {
            shopCats.map((c, i) => (
              <a href={`#cat-${c.id}`} data-reveal="scale" style={`--i:${i}`}>
                {c.label}
              </a>
            ))
          }
        </nav>

        {
          shopCats.map((c, i) => (
            <div class:list={['loja__cat', { 'rule-draw': i > 0 }]} id={`cat-${c.id}`} data-inview>
              <h2 class="loja__cat-title d" data-reveal="forge" data-split="forge">
                {c.label}
              </h2>
              <ul class="loja__grid">
                {LINES.filter((l) => l.category === c.id).map((l, i) => (
                  <ProductCard line={l} index={i} />
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <MapaBand />
  </main>
  <Footer compact />
  <MobileBar />
</Base>

<style>
  .loja-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + clamp(2rem, 6vw, 5rem));
  }

  .loja-hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .loja-hero__glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 75%;
    background: radial-gradient(closest-side, rgba(232, 18, 63, 0.22), rgba(232, 18, 63, 0.05) 55%, transparent 78%);
    pointer-events: none;
    animation: loja-glow-pulse 9s var(--ease-in-out) infinite;
  }

  .loja-hero__mono {
    position: absolute;
    top: 0;
    right: clamp(-3rem, -1vw, 3rem);
    height: clamp(260px, 42vw, 560px);
    color: var(--bone);
    opacity: 0.06;
    pointer-events: none;
  }

  .loja-hero__mono :global(svg) {
    height: 100%;
    width: auto;
  }

  @keyframes loja-glow-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .loja-hero__title {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 1.4rem + 5.2vw, 6rem);
  }

  .loja-hero .lead {
    margin-top: 1.5rem;
    max-width: 46ch;
  }

  .loja-hero .cta-row {
    margin-top: 2rem;
  }

  .loja__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .loja__jump a {
    padding: 0.6em 1.2em;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone-70);
    border: 1px solid var(--line-strong);
    transition:
      opacity var(--dur-slow) var(--ease-out) calc(var(--i, 0) * var(--stagger)),
      transform 0.9s var(--ease-spring) calc(var(--i, 0) * var(--stagger)),
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .loja__jump a:hover {
    border-color: var(--red);
    color: var(--red);
    background-color: rgba(232, 18, 63, 0.08);
    box-shadow: 0 10px 24px -14px rgba(232, 18, 63, 0.6);
  }

  :global(.js) .loja__jump a.in:hover {
    transform: translateY(-2px);
    transition-delay: 0s;
  }

  .loja__cat {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .loja__cat + .loja__cat {
    margin-top: clamp(3rem, 7vw, 5.5rem);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .loja__cat-title {
    font-size: clamp(1.8rem, 1.2rem + 2.6vw, 3rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .loja__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem clamp(1rem, 2.5vw, 2rem);
  }

  @media (min-width: 640px) {
    .loja__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .loja__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

</style>
