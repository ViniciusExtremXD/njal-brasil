---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import Monogram from '../components/Monogram.astro';
import { BRAND } from '../data/site';
import { CATEGORIES, LINES } from '../data/shop';

const shopCats = CATEGORIES.filter((c) => c.id !== 'todos');
---

<Base
  title="Loja — NJAL BRASIL"
  description="Catálogo oficial da NJAL: camisetas, moletons, regatas, shorts e acessórios. Escolha a peça e chame no WhatsApp pra fechar."
  path="/loja"
>
  <Nav />
  <main id="conteudo">
    <section class="loja-hero section--tight">
      <div class="loja-hero__glow" aria-hidden="true"></div>
      <div class="loja-hero__mono" aria-hidden="true">
        <Monogram outline strokeWidth={1} decorative />
      </div>
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>Loja oficial</b> · njal.com.br</p>
        <h1 class="loja-hero__title d" data-reveal="forge">
          Dá uma olhada<br />
          <span class="d--red" data-reveal="forge-red" style="--i:1">no catálogo real.</span>
        </h1>
        <p class="lead" data-reveal style="--i:1">
          Escolha a peça e chame no WhatsApp pra fechar — sem carrinho, sem checkout por aqui.
          Tamanho, cor e forma de pagamento se acertam direto na conversa.
        </p>
        <div class="cta-row" data-reveal style="--i:2">
          <a class="btn btn--red" href={BRAND.shopUrl} target="_blank" rel="noopener">
            Abrir njal.com.br
            <Icon name="arrow" class="btn__icon" />
          </a>
          <a class="btn" href={BRAND.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" class="btn__icon" />
            Tirar dúvida no WhatsApp
          </a>
        </div>
      </div>
    </section>

    <section class="loja section section--tight section--line" aria-label="Catálogo de produtos">
      <div class="wrap">
        <nav class="loja__jump" aria-label="Ir para categoria">
          {shopCats.map((c) => <a href={`#cat-${c.id}`}>{c.label}</a>)}
        </nav>

        {
          shopCats.map((c) => (
            <div class="loja__cat" id={`cat-${c.id}`}>
              <h2 class="loja__cat-title d">{c.label}</h2>
              <ul class="loja__grid">
                {LINES.filter((l) => l.category === c.id).map((l, i) => (
                  <ProductCard line={l} index={i} />
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="loja-mapa section--line" aria-labelledby="loja-mapa-title">
      <div class="wrap loja-mapa__head">
        <p class="eyebrow" id="loja-mapa-title">Ponto físico · {BRAND.point.name}</p>
        <a class="link" href={BRAND.point.maps} target="_blank" rel="noopener">
          Abrir no mapa <Icon name="arrow" class="btn__icon" />
        </a>
      </div>
      <iframe
        class="loja-mapa__frame"
        src={BRAND.point.mapsEmbed}
        title={`Mapa — ${BRAND.point.name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </section>
  </main>
  <Footer compact />
  <MobileBar />
</Base>

<style>
  .loja-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + clamp(2rem, 6vw, 5rem));
  }

  .loja-hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .loja-hero__glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 75%;
    background: radial-gradient(closest-side, rgba(232, 18, 63, 0.22), rgba(232, 18, 63, 0.05) 55%, transparent 78%);
    pointer-events: none;
    animation: loja-glow-pulse 9s var(--ease-in-out) infinite;
  }

  .loja-hero__mono {
    position: absolute;
    top: 0;
    right: clamp(-3rem, -1vw, 3rem);
    height: clamp(260px, 42vw, 560px);
    color: var(--bone);
    opacity: 0.06;
    pointer-events: none;
  }

  .loja-hero__mono :global(svg) {
    height: 100%;
    width: auto;
  }

  @keyframes loja-glow-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .loja-hero__title {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 1.4rem + 5.2vw, 6rem);
  }

  .loja-hero .lead {
    margin-top: 1.5rem;
    max-width: 46ch;
  }

  .loja-hero .cta-row {
    margin-top: 2rem;
  }

  .loja__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .loja__jump a {
    padding: 0.6em 1.2em;
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone-70);
    border: 1px solid var(--line-strong);
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .loja__jump a:hover {
    border-color: var(--red);
    color: var(--red);
  }

  .loja__cat {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .loja__cat + .loja__cat {
    margin-top: clamp(3rem, 7vw, 5.5rem);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .loja__cat-title {
    font-size: clamp(1.8rem, 1.2rem + 2.6vw, 3rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .loja__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem clamp(1rem, 2.5vw, 2rem);
  }

  @media (min-width: 640px) {
    .loja__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .loja__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .loja-mapa {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
  }

  .loja-mapa__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .loja-mapa__frame {
    display: block;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: clamp(320px, 42vw, 480px);
    border: 0;
    border-top: 1px solid var(--line);
  }
</style>
