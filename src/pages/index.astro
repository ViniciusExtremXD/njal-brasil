---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import LojaTeaser from '../components/LojaTeaser.astro';
import Manifesto from '../components/Manifesto.astro';
import Pilares from '../components/Pilares.astro';
import Drops from '../components/Drops.astro';
import Valhalla from '../components/Valhalla.astro';
import Tecido from '../components/Tecido.astro';
import Comunidade from '../components/Comunidade.astro';
import Confeccao from '../components/Confeccao.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
---

<Base>
  <Nav />
  <main id="conteudo">
    <Hero />
    <LojaTeaser />
    <Manifesto />
    <Pilares />
    <Drops />
    <Valhalla />
    <Tecido />
    <Comunidade />
    <Confeccao />
  </main>
  <Footer />
  <MobileBar />
</Base>
