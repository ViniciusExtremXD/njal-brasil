---
import { BRAND, NAV, withBase } from '../data/site';
import Wordmark from './Wordmark.astro';
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';

interface Props {
  /** Rodapé mais discreto: usado na /loja, onde o wordmark gigante compete com a vitrine. */
  compact?: boolean;
}
const { compact = false } = Astro.props;

const year = new Date().getFullYear();
const { scriptures, point } = BRAND;
const list = [scriptures.forged, scriptures.who, scriptures.valhalla, scriptures.armor];
const lojaHref = withBase('/loja');
---

<footer class:list={['foot', { 'foot--compact': compact }]} id="rodape">
  <div class="wrap foot__mark" data-reveal="clip">
    <Wordmark class="foot__word" title="NJAL" />
  </div>

  <div class="wrap foot__grid">
    <div class="foot__col foot__col--brand">
      <Monogram class="foot__mono" decorative />
      <p class="eyebrow"><b>{BRAND.full}</b> — {BRAND.city}</p>
      <p class="copy">{BRAND.tagline}. {scriptures.armor}</p>
      <p class="foot__say d">
        <span aria-hidden="true">✌</span> Se fala <span class="d--red">Nijal</span>
      </p>
    </div>

    <nav class="foot__col" aria-label="Seções, no rodapé">
      <p class="eyebrow foot__label">Navegar</p>
      <ul class="foot__list">
        <li>
          <a href={lojaHref} class="foot__loja">Loja</a>
        </li>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="foot__col">
      <p class="eyebrow foot__label">Canais</p>
      <ul class="foot__list">
        <li>
          <a href={BRAND.shopUrl} target="_blank" rel="noopener">
            <Icon name="arrow" class="foot__ico" /> Loja oficial · njal.com.br
          </a>
        </li>
        <li>
          <a href={BRAND.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" class="foot__ico" /> Instagram · {BRAND.handle}
          </a>
        </li>
        <li>
          <a href={BRAND.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" class="foot__ico" /> WhatsApp
          </a>
        </li>
      </ul>
      <p class="eyebrow foot__label">Ponto físico</p>
      <address class="foot__addr copy">
        {point.name}<br />
        {point.street} — {point.district}<br />
        {point.city}, {point.uf}
      </address>
      {
        compact && (
          <iframe
            class="foot__map"
            src={point.mapsEmbed}
            title={`Mapa — ${point.name}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        )
      }
      <a class="link" href={point.maps} target="_blank" rel="noopener">Abrir no mapa <Icon name="arrow" class="btn__icon" /></a>
    </div>

    <div class="foot__col">
      <p class="eyebrow foot__label">Escrituras</p>
      <ul class="foot__scr">
        {list.map((s) => <li class="d">{s}</li>)}
      </ul>
    </div>
  </div>

  <div class="wrap foot__bar">
    <p>© {year} {BRAND.full}. Todos os direitos reservados.</p>
    <p>Catálogo e checkout oficiais em njal.com.br.</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 7vw, 6rem);
    background: var(--carbon);
  }

  .foot__mark {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .foot__word {
    width: 100%;
    height: auto;
    color: var(--bone);
  }

  /* Rodapé compacto (loja): o wordmark gigante compete com a vitrine de produtos. */
  .foot--compact .foot__mark {
    max-width: 22rem;
    margin-inline: auto 0;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .foot__map {
    width: 100%;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    filter: grayscale(1) invert(92%) contrast(83%);
  }

  .foot__grid {
    display: grid;
    gap: 2.5rem var(--gap);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .foot__col {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .foot__col--brand .copy {
    max-width: 34ch;
  }

  .foot__mono {
    height: 2.4rem;
    width: auto;
    color: var(--red);
  }

  .foot__say {
    font-size: 1.3rem;
    margin-top: 0.5rem;
  }

  .foot__label {
    color: var(--bone-50);
  }

  .foot__label + .foot__label {
    margin-top: 0.75rem;
  }

  .foot__list {
    display: grid;
    gap: 0.45rem;
  }

  .foot__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    color: var(--bone-70);
    transition: color 0.2s;
  }

  .foot__list a:hover {
    color: var(--red);
  }

  .foot__loja {
    color: var(--red) !important;
  }

  .foot__ico {
    width: 1.1em;
    height: 1.1em;
  }

  .foot__addr {
    font-style: normal;
  }

  .foot__scr {
    display: grid;
    gap: 0.6rem;
  }

  .foot__scr li {
    font-size: 0.95rem;
    line-height: 1.2;
    color: var(--bone-70);
  }

  .foot__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    font-size: 0.8rem;
    color: var(--bone-50);
  }

  @media (min-width: 720px) {
    .foot__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .foot__grid {
      grid-template-columns: 1.4fr 0.8fr 1fr 1fr;
    }
  }
</style>
