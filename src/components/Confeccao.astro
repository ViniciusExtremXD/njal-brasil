---
import { B2B, BRAND } from '../data/site';
import Plate from './Plate.astro';
import Icon from './Icon.astro';
import Kicker from './Kicker.astro';
---

<section class="b2b section section--line" id="confeccao" aria-labelledby="b2b-title">
  <div class="wrap b2b__grid">
    <div class="b2b__body">
      <Kicker index="06" label="Confecção própria · B2B" />
      <h2 class="b2b__title d" id="b2b-title" data-reveal="forge" data-split="forge">
        Sua ideia.<br />
        <span class="d--red">Nossa confecção.</span>
      </h2>
      <p class="lead" data-reveal="fade" data-split="words" style="--i:1">{B2B.intro}</p>
      <ul class="b2b__list" data-inview>
        {
          B2B.bullets.map((b, i) => (
            <li data-reveal style={`--i:${i + 1}`}>
              <span class="eyebrow">
                <b>{b.label}</b>
              </span>
              <p class="copy">{b.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="cta-row" data-reveal style="--i:5">
        <a class="btn" href={BRAND.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="btn__icon" />
          Falar sobre confecção
        </a>
        <a class="btn" href={BRAND.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" class="btn__icon" />
          Ver portfólio
        </a>
      </div>

      <details class="b2b__quote" data-reveal style="--i:6">
        <summary class="btn btn--red">
          <Icon name="whatsapp" class="btn__icon" />
          Pedir orçamento
        </summary>
        <form class="b2b__form" data-quote-form>
          <label style="--n:0">
            <span class="eyebrow">Seu nome</span>
            <input type="text" name="nome" required placeholder="Como podemos te chamar" />
          </label>
          <label style="--n:1">
            <span class="eyebrow">Marca ou negócio</span>
            <input type="text" name="marca" placeholder="Se for pra uma marca, academia, box..." />
          </label>
          <div class="b2b__form-row">
            <label style="--n:2">
              <span class="eyebrow">Peça</span>
              <input type="text" name="peca" required placeholder="Camiseta, moletom, uniforme..." />
            </label>
            <label style="--n:3">
              <span class="eyebrow">Quantidade</span>
              <input type="number" name="quantidade" min="10" required placeholder="A partir de 10" />
            </label>
          </div>
          <label style="--n:4">
            <span class="eyebrow">Detalhes</span>
            <textarea name="detalhes" rows="3" placeholder="Cores, prazo, referência de peça..." />
          </label>
          <button type="submit" class="btn btn--red" style="--n:5">
            <Icon name="whatsapp" class="btn__icon" />
            Enviar pelo WhatsApp
          </button>
          <p class="eyebrow b2b__form-note" style="--n:6">
            Abre o WhatsApp com os dados já preenchidos — nada é enviado por aqui.
          </p>
        </form>
      </details>
    </div>

    <div class="b2b__arts">
      {
        B2B.arts.map((a, i) => (
          <div class:list={['b2b__plate', { 'b2b__plate--up': i === 1 }]} data-parallax={i === 0 ? '0.05' : '0.09'}>
            <Plate
              src={a.art}
              alt={a.alt}
              label={a.label}
              sizes="(max-width: 560px) calc(100vw - 2.5rem), (max-width: 1100px) 46vw, 480px"
              reveal={i === 0 ? 'left' : 'right'}
              index={i * 2}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .b2b__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .b2b__body {
    display: grid;
    gap: 1.5rem;
  }

  .b2b__title {
    font-size: clamp(2.4rem, 1.2rem + 4.2vw, 5.6rem);
  }

  .b2b__list {
    position: relative;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  /* Linhas da lista se desenham da esquerda pra direita, uma por item */
  :global(.js) .b2b__list {
    border-top-color: transparent;
  }

  :global(.js) .b2b__list::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s var(--ease-out);
  }

  :global(.js) .b2b__list.in::before {
    transform: scaleX(1);
  }

  :global(.js) .b2b__list li {
    position: relative;
    border-bottom-color: transparent;
  }

  :global(.js) .b2b__list li::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s var(--ease-out) calc(var(--i, 0) * var(--stagger) + 0.2s);
  }

  :global(.js) .b2b__list li.in::after {
    transform: scaleX(1);
  }

  .b2b__list li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }

  :global(.js) .b2b__list li {
    transition:
      opacity var(--dur-slow) var(--ease-out) calc(var(--i, 0) * var(--stagger)),
      transform 1.2s var(--ease-out) calc(var(--i, 0) * var(--stagger)),
      padding-left 0.4s var(--ease-out);
  }

  .b2b__list li:hover {
    padding-left: 0.5rem;
  }

  .b2b__list li .eyebrow b {
    display: inline-block;
    transition: transform 0.4s var(--ease-spring);
  }

  .b2b__list li:hover .eyebrow b {
    transform: translateX(3px);
  }

  .b2b__arts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    align-items: end;
  }

  .b2b__plate {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 560px) {
    .b2b__arts {
      grid-template-columns: 1fr;
    }

    .b2b__list li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  @media (min-width: 1100px) {
    .b2b__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr);
    }

    .b2b__plate--up {
      transform: translateY(-3rem);
    }
  }

  .b2b__quote {
    margin-top: -0.5rem;
  }

  .b2b__quote summary {
    list-style: none;
    cursor: pointer;
    width: fit-content;
  }

  .b2b__quote summary::-webkit-details-marker {
    display: none;
  }

  .b2b__form {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  /* O formulário desdobra suave: campos entram um a um */
  .b2b__quote[open] .b2b__form {
    animation: form-in 0.6s var(--ease-out) both;
  }

  .b2b__quote[open] .b2b__form > * {
    animation: form-field-in 0.6s var(--ease-out) both;
    animation-delay: calc(0.1s + var(--n, 0) * 70ms);
  }

  @keyframes form-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes form-field-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .b2b__form label {
    display: grid;
    gap: 0.4rem;
  }

  .b2b__form input,
  .b2b__form textarea {
    width: 100%;
    padding: 0.75em 0.9em;
    font-family: var(--font-body), sans-serif;
    font-size: 0.95rem;
    color: var(--bone);
    background: var(--carbon);
    border: 1px solid var(--line-strong);
    resize: vertical;
    transition:
      border-color 0.3s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }

  .b2b__form input:hover,
  .b2b__form textarea:hover {
    border-color: var(--bone-50);
  }

  .b2b__form input:focus-visible,
  .b2b__form textarea:focus-visible {
    outline: none;
    border-color: var(--red);
    background: var(--carbon-2);
    box-shadow: 0 0 0 3px rgba(232, 18, 63, 0.25);
  }

  .b2b__form-row {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .b2b__form-note {
    color: var(--bone-50);
  }

  @media (min-width: 480px) {
    .b2b__form-row {
      grid-template-columns: 2fr 1fr;
    }
  }

</style>

<script>
  import { waLink } from '../data/site';

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const field = (name: string) => String(data.get(name) ?? '').trim();

      const lines = [
        'Olá! Quero pedir um orçamento de confecção.',
        `Nome: ${field('nome')}`,
        field('marca') && `Marca/negócio: ${field('marca')}`,
        `Peça: ${field('peca')}`,
        `Quantidade: ${field('quantidade')}`,
        field('detalhes') && `Detalhes: ${field('detalhes')}`,
      ].filter(Boolean);

      window.open(waLink(lines.join('\n')), '_blank', 'noopener');
    });
  });
</script>
