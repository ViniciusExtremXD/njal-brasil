---
/** Vitrine da loja na home: recorte curado do catálogo real, empurrando pra /loja e pro checkout oficial. */
import { withBase } from '../data/site';
import { FEATURED } from '../data/shop';
import ProductCard from './ProductCard.astro';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
---

<section class="loja-teaser section section--tight section--line" id="loja" aria-labelledby="loja-teaser-title">
  <div class="loja-teaser__glow" aria-hidden="true"></div>
  <div class="loja-teaser__mono" aria-hidden="true">
    <Monogram outline strokeWidth={1} decorative />
  </div>

  <div class="wrap">
    <header class="sec-head">
      <Kicker index="00" label="Loja oficial" />
      <div class="sec-head__row">
        <h2 class="sec-head__title d loja-teaser__title" id="loja-teaser-title" data-reveal="forge">
          Vista a armadura.<br />
          <span class="d--red" data-reveal="forge-red" style="--i:1">Compre agora.</span>
        </h2>
        <p class="copy" data-reveal style="--i:1">
          Preço, tamanho e frete de verdade. Escolha a peça aqui e finalize a compra no checkout
          oficial da NJAL, em <strong>njal.com.br</strong>.
        </p>
      </div>
    </header>

    <ul class="loja-teaser__grid">
      {FEATURED.map((p) => <ProductCard product={p} />)}
    </ul>

    <div class="loja-teaser__foot" data-reveal>
      <a class="btn btn--red" href={withBase('/loja')}>
        Ver loja completa
        <Icon name="arrow" class="btn__icon" />
      </a>
      <p class="eyebrow loja-teaser__note">Catálogo e checkout em <b>njal.com.br</b></p>
    </div>
  </div>
</section>

<style>
  .loja-teaser {
    position: relative;
    overflow: hidden;
  }

  .loja-teaser > .wrap {
    position: relative;
    z-index: 1;
  }

  .loja-teaser__glow {
    position: absolute;
    inset: -15% -10% auto -10%;
    height: 65%;
    background: radial-gradient(closest-side, rgba(232, 18, 63, 0.2), rgba(232, 18, 63, 0.05) 55%, transparent 78%);
    pointer-events: none;
    animation: loja-glow-pulse 9s var(--ease-in-out) infinite;
  }

  .loja-teaser__mono {
    position: absolute;
    top: 50%;
    right: clamp(-3rem, -2vw, 3rem);
    transform: translateY(-50%);
    height: clamp(280px, 48vw, 640px);
    color: var(--bone);
    opacity: 0.05;
    pointer-events: none;
  }

  .loja-teaser__mono :global(svg) {
    height: 100%;
    width: auto;
  }

  @keyframes loja-glow-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .loja-teaser__title {
    font-size: clamp(2.2rem, 1.3rem + 4.4vw, 5rem);
  }

  .loja-teaser__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem clamp(1rem, 2.5vw, 2rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .loja-teaser__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .loja-teaser__note {
    color: var(--bone-50);
  }

  @media (min-width: 640px) {
    .loja-teaser__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
