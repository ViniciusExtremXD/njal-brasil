---
interface Props {
  name: 'instagram' | 'whatsapp' | 'arrow' | 'pin' | 'down';
  class?: string;
}
const { name, class: cls, ...rest } = Astro.props;
---

<svg
  class={cls}
  {...rest}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'whatsapp' && (
      <>
        <path d="M4 20l1.3-3.9A8 8 0 1 1 8.2 19z" />
        <path
          d="M9.2 8.6c.2-.5.5-.5.8-.5h.6c.2 0 .4.1.5.4l.8 1.8c.1.2 0 .4-.1.6l-.5.6c-.1.2-.1.3 0 .5.6 1.1 1.5 2 2.7 2.6.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.8.8c.3.1.4.3.4.5v.7c0 .5-.3 1-.8 1.2-1 .5-2.3.3-3.7-.5a10 10 0 0 1-3.8-3.8c-.8-1.4-1-2.7-.4-4z"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }
  {
    name === 'arrow' && (
      <>
        <path d="M5 12h14" />
        <path d="M13 6l6 6-6 6" />
      </>
    )
  }
  {
    name === 'down' && (
      <>
        <path d="M12 5v14" />
        <path d="M6 13l6 6 6-6" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10z" />
        <circle cx="12" cy="11" r="2.2" />
      </>
    )
  }
</svg>
