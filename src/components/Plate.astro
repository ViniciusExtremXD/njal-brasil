---
/**
 * Moldura de arte de campanha.
 * Regras inegociáveis: a peça aparece INTEIRA (object-fit: contain, proporção nativa),
 * nunca é ampliada acima do tamanho nativo em CSS px, e nenhuma tipografia nova é sobreposta.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  meta?: string;
  /** Largura máxima em CSS px. Nunca passa da largura nativa da arte. */
  maxWidth?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  reveal?: string | false;
  /** Posição no escalonamento da revelação (atraso = index × --stagger). */
  index?: number;
}

const {
  src,
  alt,
  label,
  meta = '@njalbrasil',
  maxWidth = src.width,
  sizes,
  loading = 'lazy',
  class: cls,
  reveal = 'scale',
  index = 0,
  ...rest
} = Astro.props;

const max = Math.min(maxWidth, src.width);
const candidates = [320, 420, 520, 640, 760, 900, 1080];
const widths = [...candidates.filter((w) => w < src.width), src.width];
const sizesAttr = sizes ?? `(max-width: 720px) calc(100vw - 2.5rem), ${max}px`;
---

<figure
  class:list={['plate', cls]}
  {...rest}
  style={`--plate-max:${max}px; --plate-ratio:${src.width} / ${src.height}; --i:${index};`}
  data-reveal={reveal === false ? undefined : reveal}
>
  <div class="plate__frame">
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizesAttr}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading={loading}
      decoding="async"
      quality={82}
    />
  </div>
  {
    (label || meta) && (
      <figcaption class="plate__cap">
        <b>{label}</b>
        <span>{meta}</span>
      </figcaption>
    )
  }
</figure>
