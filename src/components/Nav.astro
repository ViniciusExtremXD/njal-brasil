---
import { BRAND, NAV, withBase } from '../data/site';
import Monogram from './Monogram.astro';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';

const lojaHref = withBase('/loja');
const homeHref = `${withBase('/')}#topo`;
---

<header class="nav" data-nav>
  <div class="nav__in wrap">
    <a class="nav__brand" href={homeHref} aria-label="NJAL BRASIL — voltar ao início">
      <Monogram class="nav__mono" decorative />
      <Wordmark class="nav__word" decorative />
      <span class="nav__brasil">Brasil</span>
    </a>

    <nav class="nav__links" aria-label="Seções do site">
      <a href={lojaHref} class="nav__loja" style="--n:0"><span class="nav__t" data-t="Loja"><span>Loja</span></span></a>
      {
        NAV.map((item, i) => (
          <a href={item.href} style={`--n:${i + 1}`}>
            <span class="nav__t" data-t={item.label}><span>{item.label}</span></span>
          </a>
        ))
      }
    </nav>

    <div class="nav__right">
      <span class="nav__say eyebrow"><span aria-hidden="true">✌</span> <b>{BRAND.say}</b></span>
      <a class="btn btn--red btn--sm nav__wa" href={lojaHref}>
        Loja
      </a>

      <details class="nav__menu" data-menu>
        <summary class="nav__toggle">
          <span class="nav__burger" aria-hidden="true"></span>
          <span class="nav__toggle-label">Menu</span>
        </summary>
        <div class="nav__sheet">
          <ul class="nav__sheet-list">
            <li style="--n:0">
              <a class="d nav__sheet-loja" href={lojaHref}>
                Loja
              </a>
            </li>
            {
              NAV.map((item, i) => (
                <li style={`--n:${i + 1}`}>
                  <a class="d" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="nav__sheet-foot">
            <div class="cta-row">
              <a class="btn btn--red" href={lojaHref}>
                Ver a loja
              </a>
              <a class="btn" href={BRAND.whatsapp} target="_blank" rel="noopener">
                <Icon name="whatsapp" class="btn__icon" /> WhatsApp
              </a>
              <a class="btn" href={BRAND.instagram} target="_blank" rel="noopener">
                <Icon name="instagram" class="btn__icon" /> Instagram
              </a>
            </div>
            <p class="eyebrow"><span aria-hidden="true">✌</span> <b>{BRAND.say}</b> · {BRAND.city}</p>
          </div>
        </div>
      </details>
    </div>
  </div>
  <span class="nav__progress" aria-hidden="true"></span>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    view-transition-name: nav;
    height: var(--nav-h);
    background: rgba(5, 5, 6, 0.94);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  /* Entrada: a barra desce suave no carregamento */
  :global(.js) .nav {
    animation: nav-in 0.9s var(--ease-out) 0.05s backwards;
  }

  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-100%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  :global(.js) .nav:not(.is-scrolled) {
    background: transparent;
    border-color: transparent;
  }

  :global(.js) .nav.nav--hidden {
    transform: translateY(-100%);
  }

  /* Progresso de leitura: linha vermelha que cresce com o scroll */
  .nav__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--red);
    transform: scaleX(var(--scroll-p, 0));
    transform-origin: left;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }

  .nav.is-scrolled .nav__progress {
    opacity: 1;
  }

  .nav__brand {
    transition: transform 0.4s var(--ease-spring);
  }

  .nav__brand:hover {
    transform: translateX(2px);
  }

  .nav__brand:hover .nav__mono {
    animation: mono-tilt 0.6s var(--ease-spring);
  }

  @keyframes mono-tilt {
    30% {
      transform: rotate(-8deg) scale(1.08);
    }
  }

  .nav__in {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--bone);
    text-decoration: none;
    flex: none;
  }

  .nav__mono {
    height: 1.55rem;
    width: auto;
    color: var(--red);
  }

  .nav__word {
    height: 0.95rem;
    width: auto;
  }

  .nav__brasil {
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bone-50);
    padding-left: 0.6rem;
    border-left: 1px solid var(--line-strong);
    line-height: 1;
  }

  .nav__links {
    display: none;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .nav__links a {
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone-70);
    padding: 0.4rem 0;
    background-image: linear-gradient(var(--red), var(--red));
    background-repeat: no-repeat;
    background-size: 0 2px;
    background-position: 0 100%;
    transition:
      color 0.25s,
      background-size 0.35s var(--ease-out);
  }

  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--bone);
    background-size: 100% 2px;
  }

  /* Texto desliza pra cima no hover e a cópia vermelha entra por baixo (máscara no .nav__t) */
  .nav__t {
    position: relative;
    display: block;
    overflow: hidden;
    line-height: 1.2;
  }

  .nav__t > span {
    display: block;
    transition: transform 0.45s var(--ease-out);
  }

  .nav__t::after {
    content: attr(data-t);
    position: absolute;
    left: 0;
    top: 100%;
    color: var(--red);
    transition: transform 0.45s var(--ease-out);
  }

  .nav__links a:hover .nav__t > span,
  .nav__links a:hover .nav__t::after {
    transform: translateY(-100%);
  }

  /* Links entram escalonados depois da barra */
  :global(.js) .nav__links a {
    animation: nav-link-in 0.7s var(--ease-out) backwards;
    animation-delay: calc(0.35s + var(--n, 0) * 60ms);
  }

  @keyframes nav-link-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  :global(.js) .nav__right {
    animation: nav-link-in 0.7s var(--ease-out) 0.5s backwards;
  }

  .nav__loja {
    color: var(--red) !important;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav__say {
    display: none;
    white-space: nowrap;
  }

  .nav__wa {
    display: none;
  }

  /* Menu mobile: <details>, funciona sem JS */
  .nav__menu {
    position: relative;
  }

  .nav__toggle {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    min-height: 2.5rem;
    padding: 0 0.25rem;
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    user-select: none;
  }

  .nav__toggle::-webkit-details-marker {
    display: none;
  }

  .nav__burger {
    position: relative;
    width: 1.4rem;
    height: 2px;
    background: var(--bone);
    transition: background-color 0.2s;
  }

  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--bone);
    transition: transform 0.3s var(--ease-out);
  }

  .nav__burger::before {
    top: -6px;
  }

  .nav__burger::after {
    top: 6px;
  }

  .nav__menu[open] .nav__burger {
    background: transparent;
  }

  .nav__menu[open] .nav__burger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .nav__menu[open] .nav__burger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav__sheet {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: var(--ink);
    border-top: 1px solid var(--line);
    padding: clamp(1.5rem, 6vw, 3rem) var(--pad) calc(var(--pad) + 4.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    overflow-y: auto;
  }

  .nav__sheet-list li {
    border-top: 1px solid var(--line);
  }

  .nav__sheet-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .nav__sheet-list a {
    display: block;
    padding: 0.55em 0;
    font-size: clamp(2rem, 9vw, 3.4rem);
    text-decoration: none;
    color: var(--bone);
    transform: translateY(0.4em);
    opacity: 0;
    animation: sheet-in 0.6s var(--ease-out) forwards;
    animation-delay: calc(var(--n) * 60ms);
  }

  .nav__sheet-list a:hover {
    color: var(--red);
  }

  .nav__sheet-loja {
    color: var(--red);
  }

  .nav__sheet-foot {
    display: grid;
    gap: 1.25rem;
  }

  @keyframes sheet-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 960px) {
    .nav__links {
      display: flex;
    }

    .nav__wa {
      display: inline-flex;
    }

    .nav__menu {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .nav__say {
      display: inline;
    }
  }

</style>
