---
import { BRAND, NAV } from '../data/site';
import Monogram from './Monogram.astro';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
---

<header class="nav" data-nav>
  <div class="nav__in wrap">
    <a class="nav__brand" href="#topo" aria-label="NJAL BRASIL — voltar ao início">
      <Monogram class="nav__mono" decorative />
      <Wordmark class="nav__word" decorative />
      <span class="nav__brasil">Brasil</span>
    </a>

    <nav class="nav__links" aria-label="Seções do site">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="nav__right">
      <span class="nav__say eyebrow"><span aria-hidden="true">✌</span> <b>{BRAND.say}</b></span>
      <a class="btn btn--red btn--sm nav__wa" href={BRAND.whatsapp} target="_blank" rel="noopener">
        <Icon name="whatsapp" class="btn__icon" />
        WhatsApp
      </a>

      <details class="nav__menu" data-menu>
        <summary class="nav__toggle">
          <span class="nav__burger" aria-hidden="true"></span>
          <span class="nav__toggle-label">Menu</span>
        </summary>
        <div class="nav__sheet">
          <ul class="nav__sheet-list">
            {
              NAV.map((item, i) => (
                <li style={`--n:${i}`}>
                  <a class="d" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="nav__sheet-foot">
            <div class="cta-row">
              <a class="btn btn--red" href={BRAND.whatsapp} target="_blank" rel="noopener">
                <Icon name="whatsapp" class="btn__icon" /> WhatsApp
              </a>
              <a class="btn" href={BRAND.instagram} target="_blank" rel="noopener">
                <Icon name="instagram" class="btn__icon" /> Instagram
              </a>
            </div>
            <p class="eyebrow"><span aria-hidden="true">✌</span> <b>{BRAND.say}</b> · {BRAND.city}</p>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    background: rgba(5, 5, 6, 0.94);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out);
  }

  :global(.js) .nav:not(.is-scrolled) {
    background: transparent;
    border-color: transparent;
  }

  .nav__in {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--bone);
    text-decoration: none;
    flex: none;
  }

  .nav__mono {
    height: 1.55rem;
    width: auto;
    color: var(--red);
  }

  .nav__word {
    height: 0.95rem;
    width: auto;
  }

  .nav__brasil {
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bone-50);
    padding-left: 0.6rem;
    border-left: 1px solid var(--line-strong);
    line-height: 1;
  }

  .nav__links {
    display: none;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .nav__links a {
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone-70);
    padding: 0.4rem 0;
    background-image: linear-gradient(var(--red), var(--red));
    background-repeat: no-repeat;
    background-size: 0 2px;
    background-position: 0 100%;
    transition:
      color 0.25s,
      background-size 0.35s var(--ease-out);
  }

  .nav__links a:hover {
    color: var(--bone);
    background-size: 100% 2px;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav__say {
    display: none;
    white-space: nowrap;
  }

  .nav__wa {
    display: none;
  }

  /* Menu mobile: <details>, funciona sem JS */
  .nav__menu {
    position: relative;
  }

  .nav__toggle {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    min-height: 2.5rem;
    padding: 0 0.25rem;
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    user-select: none;
  }

  .nav__toggle::-webkit-details-marker {
    display: none;
  }

  .nav__burger {
    position: relative;
    width: 1.4rem;
    height: 2px;
    background: var(--bone);
    transition: background-color 0.2s;
  }

  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--bone);
    transition: transform 0.3s var(--ease-out);
  }

  .nav__burger::before {
    top: -6px;
  }

  .nav__burger::after {
    top: 6px;
  }

  .nav__menu[open] .nav__burger {
    background: transparent;
  }

  .nav__menu[open] .nav__burger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .nav__menu[open] .nav__burger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav__sheet {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: var(--ink);
    border-top: 1px solid var(--line);
    padding: clamp(1.5rem, 6vw, 3rem) var(--pad) calc(var(--pad) + 4.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    overflow-y: auto;
  }

  .nav__sheet-list li {
    border-top: 1px solid var(--line);
  }

  .nav__sheet-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .nav__sheet-list a {
    display: block;
    padding: 0.55em 0;
    font-size: clamp(2rem, 9vw, 3.4rem);
    text-decoration: none;
    color: var(--bone);
    transform: translateY(0.4em);
    opacity: 0;
    animation: sheet-in 0.6s var(--ease-out) forwards;
    animation-delay: calc(var(--n) * 60ms);
  }

  .nav__sheet-list a:hover {
    color: var(--red);
  }

  .nav__sheet-foot {
    display: grid;
    gap: 1.25rem;
  }

  @keyframes sheet-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 960px) {
    .nav__links {
      display: flex;
    }

    .nav__wa {
      display: inline-flex;
    }

    .nav__menu {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .nav__say {
      display: inline;
    }
  }
</style>
