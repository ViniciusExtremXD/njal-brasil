---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { BRAND } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Caminho da página relativo à raiz do site (sem base). */
  path?: string;
  noindex?: boolean;
}

const {
  title = 'NJAL BRASIL — Forged for Champions',
  description = 'NJAL BRASIL: vestuário de treino de alta intensidade, São Paulo. Crossfit RX, Valhalla, Jiu-Jitsu No-Gi, streetwear oversized e confecção própria. Loja oficial em njal.com.br. Se fala NIJAL.',
  path = '/',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}/${p.replace(/^\//, '')}`;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(`${base}${path}`, site).href;
const ogImage = new URL(asset('og.jpg'), site).href;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND.full,
  alternateName: BRAND.name,
  url: canonical,
  logo: new URL(asset('icon-512.png'), site).href,
  sameAs: [BRAND.instagram],
  slogan: BRAND.scriptures.forged,
  areaServed: 'BR',
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050506" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.full} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1182" />
    <meta property="og:image:height" content="1182" />
    <meta property="og:image:alt" content="Arte oficial NJAL: Para quem é a NJAL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <slot />

    <script>
      /* Revelações por scroll. Sem JS, nada é escondido (ver global.css). */
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const show = (el: Element) => el.classList.add('in');

      if (!('IntersectionObserver' in window)) {
        els.forEach(show);
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                show(entry.target);
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' },
        );
        els.forEach((el) => io.observe(el));

        // Seguro: o que já está perto do viewport aparece mesmo que o observer falhe.
        const safety = () => {
          const limit = window.innerHeight * 1.3;
          for (const el of els) {
            if (!el.classList.contains('in') && el.getBoundingClientRect().top < limit) show(el);
          }
        };
        window.setTimeout(safety, 1200);
        window.addEventListener('load', () => window.setTimeout(safety, 250), { once: true });
      }

      /* Navegação: fundo sólido depois do primeiro scroll, some ao descer, volta ao subir. */
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      if (nav) {
        const menu = nav.querySelector<HTMLDetailsElement>('[data-menu]');
        let lastY = window.scrollY;

        const onScroll = () => {
          const y = window.scrollY;
          nav.classList.toggle('is-scrolled', y > 24);

          if (!menu?.open) {
            if (y > lastY && y > nav.offsetHeight * 1.5) {
              nav.classList.add('nav--hidden');
            } else if (y < lastY) {
              nav.classList.remove('nav--hidden');
            }
          }

          lastY = y;
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      /* Menu mobile fecha ao escolher uma seção. */
      document.querySelectorAll<HTMLAnchorElement>('[data-menu] a').forEach((a) => {
        a.addEventListener('click', () => {
          const details = a.closest('details');
          if (details) details.open = false;
        });
      });
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: 1rem;
    top: -100%;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--red);
    color: var(--ink);
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    text-decoration: none;
  }

  .skip:focus {
    top: 1rem;
  }
</style>
