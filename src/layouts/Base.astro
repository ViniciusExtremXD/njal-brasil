---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { BRAND } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Caminho da página relativo à raiz do site (sem base). */
  path?: string;
  noindex?: boolean;
}

const {
  title = 'NJAL BRASIL — Forged for Champions',
  description = 'NJAL BRASIL: vestuário de treino de alta intensidade, São Paulo. Crossfit RX, Valhalla, Jiu-Jitsu No-Gi, streetwear oversized e confecção própria. Loja oficial em njal.com.br. Se fala NIJAL.',
  path = '/',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}/${p.replace(/^\//, '')}`;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(`${base}${path}`, site).href;
const ogImage = new URL(asset('og.jpg'), site).href;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND.full,
  alternateName: BRAND.name,
  url: canonical,
  logo: new URL(asset('icon-512.png'), site).href,
  sameAs: [BRAND.instagram],
  slogan: BRAND.scriptures.forged,
  areaServed: 'BR',
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050506" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.full} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1182" />
    <meta property="og:image:height" content="1182" />
    <meta property="og:image:alt" content="Arte oficial NJAL: Para quem é a NJAL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />

    <script is:inline>
      /* Antes da primeira pintura: liga o modo "com JS" (revelações escondem até entrar em cena),
         restaura a preferência de movimento salva e arma um seguro — se o motor de movimento
         não carregar em 4s, tudo aparece sem animação em vez de ficar invisível. */
      var h = document.documentElement;
      h.classList.add('js');
      try {
        if (localStorage.getItem('njal-motion') === 'reduced') h.classList.add('motion-reduced');
      } catch (e) {}
      setTimeout(function () {
        if (!window.__njalMotion) h.classList.add('motion-failed');
      }, 4000);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <slot />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: 1rem;
    top: -100%;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--red);
    color: var(--ink);
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    text-decoration: none;
  }

  .skip:focus {
    top: 1rem;
  }
</style>
